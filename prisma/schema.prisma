generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR
  SUPERVISOR
  WAREHOUSE_OPERATOR
  RECEIVING_OPERATOR
  VIEWER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  REMOTE
  LEAVE
  SICKNESS
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum ReceiptStatus {
  DRAFT
  ARRIVED
  CHECKING
  ACCEPTED
  REJECTED
  CLOSED
}

enum MovementType {
  INBOUND
  PUTAWAY
  TRANSFER
  OUTBOUND
  ADJUSTMENT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Comunicazioni esclusivamente interne al portale: non vengono inoltrate a
// provider e-mail o servizi esterni.
enum CommunicationKind {
  MESSAGE
  REQUEST
}

enum CommunicationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                     String                    @id @default(cuid())
  email                  String                    @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   UserRole                  @default(VIEWER)
  active                 Boolean                   @default(true)
  employee               Employee?
  authoredCommunications DepartmentCommunication[] @relation("CommunicationAuthor")
  communicationMessages  CommunicationMessage[]    @relation("CommunicationMessageAuthor")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
}

model Department {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  name                   String
  employees              Employee[]
  sentCommunications     DepartmentCommunication[] @relation("CommunicationSenderDepartment")
  receivedCommunications DepartmentCommunication[] @relation("CommunicationRecipientDepartment")
  createdAt              DateTime                  @default(now())
}

model JobProfile {
  id          String     @id @default(cuid())
  code        String     @unique
  title       String
  description String     @db.Text
  skills      Json?
  employees   Employee[]
  tasks       WorkTask[]
}

model Employee {
  id               String            @id @default(cuid())
  code             String            @unique
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  jobProfileId     String?
  jobProfile       JobProfile?       @relation(fields: [jobProfileId], references: [id])
  hiredAt          DateTime
  clockEvents      ClockEvent[]
  shiftAssignments ShiftAssignment[]
  workTasks        WorkTask[]
  createdAt        DateTime          @default(now())
}

model ClockEvent {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  occurredAt DateTime @default(now())
  type       String
  source     String   @default("PORTAL")
  note       String?

  @@index([employeeId, occurredAt])
}

model AttendanceDay {
  id              String           @id @default(cuid())
  employeeId      String
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  workedMinutes   Int              @default(0)
  expectedMinutes Int              @default(480)
  note            String?

  @@unique([employeeId, date])
}

model ShiftTemplate {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  startsAt     String
  endsAt       String
  breakMinutes Int               @default(30)
  color        String            @default("#2563eb")
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  templateId String
  template   ShiftTemplate @relation(fields: [templateId], references: [id])
  date       DateTime      @db.Date
  status     ShiftStatus   @default(DRAFT)

  @@unique([employeeId, date])
}

model WorkTask {
  id           String      @id @default(cuid())
  title        String
  description  String?     @db.Text
  priority     Priority    @default(NORMAL)
  dueAt        DateTime?
  completedAt  DateTime?
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  jobProfileId String?
  jobProfile   JobProfile? @relation(fields: [jobProfileId], references: [id])
  createdAt    DateTime    @default(now())
}

model DepartmentCommunication {
  id                    String                 @id @default(cuid())
  // Stable reference used by imports, audit exports and idempotent demo data.
  reference             String                 @unique
  title                 String                 @db.VarChar(180)
  content               String                 @db.Text
  kind                  CommunicationKind      @default(REQUEST)
  priority              Priority               @default(NORMAL)
  status                CommunicationStatus    @default(OPEN)
  senderDepartmentId    String
  senderDepartment      Department             @relation("CommunicationSenderDepartment", fields: [senderDepartmentId], references: [id])
  recipientDepartmentId String
  recipientDepartment   Department             @relation("CommunicationRecipientDepartment", fields: [recipientDepartmentId], references: [id])
  authorId              String
  author                User                   @relation("CommunicationAuthor", fields: [authorId], references: [id])
  messages              CommunicationMessage[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  closedAt              DateTime?

  @@index([senderDepartmentId, createdAt])
  @@index([recipientDepartmentId, status, priority, createdAt])
  @@index([authorId, createdAt])
}

model CommunicationMessage {
  id              String                  @id @default(cuid())
  communicationId String
  communication   DepartmentCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                    @relation("CommunicationMessageAuthor", fields: [authorId], references: [id])
  content         String                  @db.Text
  createdAt       DateTime                @default(now())

  @@index([communicationId, createdAt])
  @@index([authorId, createdAt])
}

model Supplier {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  vatNumber String?
  email     String?
  receipts  GoodsReceipt[]
}

model Warehouse {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  address   String?
  locations StockLocation[]
  receipts  GoodsReceipt[]
}

model StockLocation {
  id          String           @id @default(cuid())
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  code        String
  description String?
  stocks      InventoryStock[]

  @@unique([warehouseId, code])
}

model Item {
  id           String           @id @default(cuid())
  sku          String           @unique
  barcode      String?          @unique
  name         String
  unit         String           @default("PZ")
  minStock     Decimal          @default(0) @db.Decimal(12, 3)
  receiptLines ReceiptLine[]
  stocks       InventoryStock[]
  movements    StockMovement[]
}

model GoodsReceipt {
  id            String        @id @default(cuid())
  number        String        @unique
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  expectedAt    DateTime?
  arrivedAt     DateTime?
  status        ReceiptStatus @default(DRAFT)
  carrier       String?
  vehiclePlate  String?
  purchaseOrder String?
  notes         String?       @db.Text
  lines         ReceiptLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ReceiptLine {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  expectedQty Decimal      @db.Decimal(12, 3)
  receivedQty Decimal      @default(0) @db.Decimal(12, 3)
  acceptedQty Decimal      @default(0) @db.Decimal(12, 3)
  rejectedQty Decimal      @default(0) @db.Decimal(12, 3)
  locationId  String?

  @@index([receiptId])
}

model InventoryStock {
  id         String        @id @default(cuid())
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])
  quantity   Decimal       @default(0) @db.Decimal(12, 3)

  @@unique([itemId, locationId])
}

model StockMovement {
  id             String       @id @default(cuid())
  type           MovementType
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  fromLocationId String?
  toLocationId   String?
  quantity       Decimal      @db.Decimal(12, 3)
  reference      String?
  occurredAt     DateTime     @default(now())
  operatorId     String?
  note           String?
}
